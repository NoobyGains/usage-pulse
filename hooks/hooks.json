{
  "description": "Keeps the status line pointing at the current plugin folder after a plugin update",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/claude_status.py\" --sync-install-path; python \"${CLAUDE_PLUGIN_ROOT}/claude_status.py\" --sync-install-path; exit 0",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
